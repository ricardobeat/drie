{
    "langrev": "1",
    "dependency-search-paths": [
        "lib"
    ],
    "dependencies": [
        "sokol"
    ],
    "sources": [
        "src/**",
        "generated/*"
    ],
    "c-sources": [
        "platform/display.c",
        "platform/cgltf.c",
        "platform/readback.c",
        "platform/gpucaps.c",
        "platform/gputimer.c",
        "platform/gputimer_win.c",
        "platform/gputimer_gl.c",
        "platform/imageio.c",
        "platform/gamectl.c",
        "platform/readback_win.c",
        "platform/imageio_win.c",
        "platform/gamectl_win.c"
    ],
    "output": "build",
    "targets": {
        "drie-macos": {
            "type": "executable",
            "c-sources-override": [],
            "linked-libraries": ["drie_c"],
            "linker-search-paths": ["build/c/macos-aarch64"],
            "cflags": "-O2 -DNDEBUG -x objective-c -fobjc-arc"
        },
        "drie-linux": {
            "type": "executable"
        },
        "drie-windows": {
            "type": "executable"
        }
    }
}
