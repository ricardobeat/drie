            desc.texture_sampler_pairs[20].view_slot = 25;
            desc.texture_sampler_pairs[20].sampler_slot = 5;
            desc.texture_sampler_pairs[21].stage = SgShaderStage.FRAGMENT;
            desc.texture_sampler_pairs[21].view_slot = 19;
            desc.texture_sampler_pairs[21].sampler_slot = 4;
    }
    return desc;
}
