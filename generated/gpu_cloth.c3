    #include <metal_stdlib>
    #include <simd/simd.h>

    using namespace metal;

    template<typename T, size_t Num>
    struct spvUnsafeArray
    {
        T elements[Num ? Num : 1];

        thread T& operator [] (size_t pos) thread
        {
            return elements[pos];
        }
        constexpr const thread T& operator [] (size_t pos) const thread
        {
            return elements[pos];
        }

        device T& operator [] (size_t pos) device
        {
            return elements[pos];
        }
        constexpr const device T& operator [] (size_t pos) const device
        {
            return elements[pos];
        }

        constexpr const constant T& operator [] (size_t pos) const constant
        {
            return elements[pos];
        }

        threadgroup T& operator [] (size_t pos) threadgroup
        {
            return elements[pos];
        }
        constexpr const threadgroup T& operator [] (size_t pos) const threadgroup
        {
            return elements[pos];
        }
    };

    struct gc_collider
    {
        float4 info;
        float4 mass;
        float4 corr_off;
        float4 corr_dv;
        float4 from_a;
        float4 a;
        float4 from_b;
        float4 b;
        float4 from_x;
        float4 from_y;
        float4 x;
        float4 y;
        float4 half_size;
    };

    struct gc_params
    {
        int4 gc_counts;
        int4 gc_range;
        float4 gc_step;
        float4 gc_gravity;
        float4 gc_wind;
        float4 gc_sweep;
        float4 gc_origin;
        float4 gc_gust;
        float4 gc_self;
        float4 gc_mode;
        int4 gc_grid;
    };

    struct gc_pin
    {
        float4 p;
    };

    struct gc_collb_pins
    {
        gc_pin pins[1];
    };

    struct gc_point
    {
        float4 p;
    };

    struct gc_collb_pos
    {
        gc_point pos[1];
    };

    struct gc_collb_prev
    {
