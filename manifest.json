{
    "provides": "drie",
    "linklib-dir": "build/c",
    "sources": [
        "src/**",
        "generated/*"
    ],
    "dependencies": [
        "sokol"
    ],
    "c-sources": [
        "platform/display.c",
        "platform/cgltf.c",
        "platform/readback.c",
        "platform/gpucaps.c",
        "platform/gputimer.c",
        "platform/gputimer_win.c",
        "platform/gputimer_gl.c",
        "platform/imageio.c",
        "platform/gamectl.c",
        "platform/readback_win.c",
        "platform/imageio_win.c",
        "platform/gamectl_win.c"
    ],
    "targets": {
        "macos-aarch64": {
            "c-sources-override": [],
            "linked-libraries": ["drie_c"],
            "cflags-override": "-O2 -DNDEBUG -x objective-c -fobjc-arc"
        },
        "macos-x64": {
            "cflags-override": "-O2 -DNDEBUG -x objective-c -fobjc-arc"
        },
        "linux-x64": {},
        "windows-x64": {},
        "mingw-x64": {
            "c-sources-override": [],
            "linked-libraries": ["drie_c"],
            "cflags-override": "-O2 -DNDEBUG"
        },
        "ios-aarch64": {
            "c-sources-override": [],
            "linked-libraries": ["drie_c"],
            "cflags-override": "-O2 -DNDEBUG -x objective-c -fobjc-arc"
        },
        "ios-aarch64-sim": {
            "c-sources-override": [],
            "linked-libraries": ["drie_c"],
            "cflags-override": "-O2 -DNDEBUG -x objective-c -fobjc-arc"
        },
        "linux-aarch64": {}
    }
}
