        Tex.GetDimensions(Level, ret.x, ret.y, Param);
        return ret;
    }

    uint3 spvTextureSize(Texture2DArray<float4> Tex, uint Level, out uint Param)
    {
        uint3 ret;
        Tex.GetDimensions(Level, ret.x, ret.y, ret.z, Param);
        return ret;
    }

