fn SgShaderDesc three_opaque_mrt_shader_desc(SgBackend backend)
{
    SgShaderDesc desc;
    desc.label = "three_opaque_mrt_shader";
    switch (backend)
    {
        case SgBackend.GLCORE:
            desc.vertex_func.source = (ZString)&VS_SOURCE_GLSL430;
            desc.vertex_func.entry = "main";
            desc.fragment_func.source = (ZString)&FS_OPAQUE_MRT_SOURCE_GLSL430;
            desc.fragment_func.entry = "main";
            desc.attrs[0].base_type = SgShaderAttrBaseType.FLOAT;
            desc.attrs[0].glsl_name = "position";
            desc.attrs[1].base_type = SgShaderAttrBaseType.FLOAT;
            desc.attrs[1].glsl_name = "normal";
            desc.attrs[2].base_type = SgShaderAttrBaseType.FLOAT;
            desc.attrs[2].glsl_name = "uv";
            desc.attrs[3].base_type = SgShaderAttrBaseType.FLOAT;
            desc.attrs[3].glsl_name = "color0";
            desc.attrs[4].base_type = SgShaderAttrBaseType.FLOAT;
            desc.attrs[4].glsl_name = "uv1";
            desc.attrs[5].base_type = SgShaderAttrBaseType.FLOAT;
            desc.attrs[5].glsl_name = "tangent";
