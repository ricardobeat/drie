            desc.texture_sampler_pairs[8].stage = SgShaderStage.FRAGMENT;
            desc.texture_sampler_pairs[8].view_slot = 21;
            desc.texture_sampler_pairs[8].sampler_slot = 4;
            desc.texture_sampler_pairs[9].stage = SgShaderStage.FRAGMENT;
            desc.texture_sampler_pairs[9].view_slot = 8;
            desc.texture_sampler_pairs[9].sampler_slot = 4;
            desc.texture_sampler_pairs[10].stage = SgShaderStage.FRAGMENT;
            desc.texture_sampler_pairs[10].view_slot = 20;
            desc.texture_sampler_pairs[10].sampler_slot = 4;
            desc.texture_sampler_pairs[11].stage = SgShaderStage.FRAGMENT;
            desc.texture_sampler_pairs[11].view_slot = 7;
