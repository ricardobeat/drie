{
    "provides": "draco",
    "c-sources": [],
    "targets": {
        "macos-aarch64": {
            "cflags-override": "-x c++ -std=c++17 -O2 -DNDEBUG -mmacos-version-min=14.0 -I/opt/homebrew/opt/draco/include",
            "c-sources-override": [
                "draco_cpp.c"
            ],
            "link-args": [
                "/opt/homebrew/opt/draco/lib/libdraco.a"
            ],
            "linked-libraries": [
                "c++"
            ]
        }
    }
}
