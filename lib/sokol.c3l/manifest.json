{
    "provides": "sokol",
    "linklib-dir": "build/c",
    "c-sources": [
        "c/sokol.c"
    ],
    "targets": {
        "macos-aarch64": {
            "c-sources-override": [],
            "cflags-override": "-O2 -DNDEBUG -DIMPL -x objective-c -DSOKOL_METAL",
            "linked-libraries": [
                "sokol_c",
                "Foundation.framework",
                "CoreGraphics.framework",
                "Cocoa.framework",
                "QuartzCore.framework",
                "CoreAudio.framework",
                "AudioToolbox.framework",
                "Metal.framework",
                "MetalKit.framework",
                "c"
            ]
        },
        "linux-x64": {
            "cflags-override": "-O2 -DNDEBUG -DIMPL -DSOKOL_GLCORE",
            "linked-libraries": [
                "X11",
                "Xi",
                "Xcursor",
                "GL",
                "pulse-simple",
                "pulse",
                "dl",
                "pthread",
                "m"
            ]
        },
        "windows-x64": {
            "cflags-override": "-O2 -DNDEBUG -DIMPL -DSOKOL_D3D11",
            "linked-libraries": [
                "kernel32",
                "user32",
                "gdi32",
                "shell32",
                "ole32",
                "d3d11",
                "dxgi"
            ]
        },
        "mingw-x64": {
            "c-sources-override": [],
            "cflags-override": "-O2 -DNDEBUG -DIMPL -DSOKOL_D3D11",
            "linked-libraries": [
                "sokol_c",
                "kernel32",
                "user32",
                "gdi32",
                "shell32",
                "ole32",
                "d3d11",
                "dxgi"
            ]
        },
        "ios-aarch64": {
            "c-sources-override": [],
            "cflags-override": "-O2 -DNDEBUG -DIMPL -x objective-c -DSOKOL_METAL",
            "linked-libraries": [
                "sokol_c",
                "Foundation.framework",
                "UIKit.framework",
                "QuartzCore.framework",
                "Metal.framework",
                "MetalKit.framework",
                "AudioToolbox.framework",
                "AVFoundation.framework"
            ]
        },
        "ios-aarch64-sim": {
            "c-sources-override": [],
            "cflags-override": "-O2 -DNDEBUG -DIMPL -x objective-c -DSOKOL_METAL",
            "linked-libraries": [
                "sokol_c",
                "Foundation.framework",
                "UIKit.framework",
                "QuartzCore.framework",
                "Metal.framework",
                "MetalKit.framework",
                "AudioToolbox.framework",
                "AVFoundation.framework"
            ]
        },
        "linux-aarch64": {
            "cflags-override": "-O2 -DNDEBUG -DIMPL -DSOKOL_GLCORE",
            "linked-libraries": [
                "X11",
                "Xi",
                "Xcursor",
                "GL",
                "pulse-simple",
                "pulse",
                "dl",
                "pthread",
                "m"
            ]
        }
    }
}
