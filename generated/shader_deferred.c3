        float4 output_params;
        float4 ambient;
        float4 hemi_sky;
        float4 hemi_ground;
        float4 gi_min[4];
        float4 gi_inv_size[4];
        float4 gi_dims[4];
        float4 gi_atlas[4];
        float4 fog_color;
        float4 fog_params;
        float4 fog_box_min;
