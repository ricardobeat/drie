    vec4 ext_slot_texel(int slot, vec2 uv)
    {
        if (slot == 0)
        {
            return textureLod(tex_ext0_tex_smp, uv, 0.0);
        }
        if (slot == 1)
        {
            return textureLod(tex_ext1_tex_smp, uv, 0.0);
        }
        if (slot == 2)
        {
            return textureLod(tex_ext2_tex_smp, uv, 0.0);
        }
        if (slot == 3)
        {
            return textureLod(tex_ext3_tex_smp, uv, 0.0);
        }
        if (slot == 4)
        {
            return textureLod(tex_ext4_tex_smp, uv, 0.0);
        }
        if (slot == 5)
        {
            return textureLod(tex_ext5_tex_smp, uv, 0.0);
        }
        return vec4(1.0);
    }

    vec4 parallax_height(vec2 uv)
    {
        return textureGrad(tex_parallax_tex_smp, uv, g_duvdx, g_duvdy);
    }

    void parallax_offset(vec3 n, vec3 v, float dist)
    {
        g_parallax_depth = fs_params[116].x * (1.0 - smoothstep(fs_params[116].y * 0.60000002384185791015625, fs_params[116].y, dist));
