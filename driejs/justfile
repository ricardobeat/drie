# driejs: three.js code running on drie, in boomkat (see README.md). `just` lists the recipes.
# boomkat comes from its jit branch, fetched from c3.ricar.do into lib/boomkat.c3l (project.json).

libs := "--libdir lib --libdir ../lib --lib sokol --lib drie"
macos := if os() == "macos" { "--macos-min-version 15.0" } else { "" }

# three.js: its npm package (build/ and examples/jsm) and, for the demos' models and textures,
# its examples at the same release. To update it, change these and the sha256s below.
three_version := "0.187.0"
three_tag := "r187"
three_sha256 := "ff540832ded0cfe919764d24a3d88f3e2a05f23303f876423e4f893841e90728"
examples := "https://raw.githubusercontent.com/mrdoob/three.js/" + three_tag + "/examples"

[private]
default:
    @just --list

# build out/driejs
build: deps
    c3c build driejs

# build, then run: `just run demos/webgl_geometries.js`, `just run --frames 3 --png shot.png demos/x.js`
run +args: build
    out/driejs {{args}}

# the demos' thumbnails, for demos/index.js (`just run demos/index.js`): each demo's picture
# after `frames` frames, into demos/thumbs/ (not in git), a quarter of the size where sips is
# there to shrink it. `just thumbs 30 webgl_geometries` renders that one only
thumbs frames="30" *names: build
    #!/bin/sh
    mkdir -p demos/thumbs
    names="{{names}}"
    [ -n "$names" ] || names=$(ls demos/*.js | sed 's|demos/||; s|\.js$||' | grep -v '^index$')
    for n in $names; do
        if out/driejs --frames {{frames}} --png demos/thumbs/$n.png demos/$n.js > /dev/null 2>&1; then
            command -v sips > /dev/null && sips -Z 640 demos/thumbs/$n.png > /dev/null 2>&1
            echo "$n"
        else
            echo "$n: failed"
        fi
    done

# BOOMKAT=path overrides ../../boomkat/out/boomkat (the -jit and -opt runs pass --jit and --opt:
# point it at a build of the jit branch).
[doc("the benchmark on one runtime (drie, drie-js, node, bun, node-jitless, boomkat, boomkat-jit, boomkat-opt) or all")]
bench which="all":
    #!/bin/sh
    set -e
    run() {
        echo "== $1"
        case $1 in
        drie)
            mkdir -p build
            c3c compile -O3 {{macos}} {{libs}} bench/drie_bench.c3 -o build/drie_bench > /dev/null
            build/drie_bench ;;
        drie-js) (cd ../../drie-js && out/drie_js --script ../drie/driejs/bench/driejs_bench.js) ;;
        node) node bench/three_bench.js ;;
        node-jitless) node --jitless bench/three_bench.js ;;
        bun) bun bench/three_bench.js ;;
        boomkat) "${BOOMKAT:-../../boomkat/out/boomkat}" bench/three_bench.js ;;
        boomkat-jit) "${BOOMKAT:-../../boomkat/out/boomkat}" --jit bench/three_bench.js ;;
        boomkat-opt) "${BOOMKAT:-../../boomkat/out/boomkat}" --opt bench/three_bench.js ;;
        *) echo "no benchmark called $1" >&2; exit 1 ;;
        esac
    }
    if [ "{{which}}" = all ]; then
        for r in drie drie-js node bun node-jitless boomkat; do run $r; done
    else
        run "{{which}}"
    fi

# fetch and build what the build needs (only what is missing)
deps: boomkat draco wamr three assets

# boomkat's jit branch, from the registry (project.json); `rm -rf lib/boomkat.c3l` to update it
[private]
boomkat:
    [ -d lib/boomkat.c3l ] || c3c project fetch ricardobeat/boomkat

# WAMR 2.4.5 (WebAssembly for js/wasm.js): its fast interpreter, as a static library in
# third_party/wamr-build (libiwasm.a, or iwasm.lib on Windows)
[private]
wamr:
    #!/usr/bin/env bash
    set -e
    case "{{os()}}" in macos) platform=darwin ;; windows) platform=windows ;; *) platform=linux ;; esac
    case "{{arch()}}" in aarch64) target=AARCH64 ;; *) target=X86_64 ;; esac
    lib=third_party/wamr-build/libiwasm.a; [ $platform = windows ] && lib=third_party/wamr-build/iwasm.lib
    [ -f $lib ] && exit 0
    [ -d third_party/wamr ] || git clone -q --depth 1 --branch WAMR-2.4.5 \
        https://github.com/bytecodealliance/wasm-micro-runtime.git third_party/wamr
    cmake -S third_party/wamr/product-mini/platforms/$platform -B third_party/wamr-build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_OSX_DEPLOYMENT_TARGET=15.0 -DWAMR_BUILD_TARGET=$target \
        -DWAMR_BUILD_INTERP=1 -DWAMR_BUILD_FAST_INTERP=1 -DWAMR_BUILD_AOT=0 -DWAMR_BUILD_JIT=0 \
        -DWAMR_BUILD_FAST_JIT=0 -DWAMR_BUILD_LIBC_BUILTIN=0 -DWAMR_BUILD_LIBC_WASI=0 \
        -DWAMR_BUILD_SIMD=0 -DWAMR_BUILD_BULK_MEMORY=1 -DWAMR_BUILD_REF_TYPES=1 \
        -DWAMR_BUILD_MULTI_MODULE=0 > /dev/null
    cmake --build third_party/wamr-build --config Release --target vmlib -j8 > /dev/null
    # the library's name and folder differ by generator: copy it where wamr.c3l links it
    built=$(find third_party/wamr-build -name libiwasm.a -o -name iwasm.lib -o -name vmlib.lib -o -name libvmlib.a | head -1)
    [ "$built" = "$lib" ] || cp "$built" $lib

# libdraco (DRACOLoader's decoder) in third_party/draco/{include,lib}, where draco.c3l looks:
# from Homebrew (brew install draco), apt (libdraco-dev) or vcpkg (draco, DRACO_TRIPLET)
[private]
draco:
    #!/usr/bin/env bash
    set -e
    [ -e third_party/draco/include/draco ] && exit 0
    mkdir -p third_party/draco
    case "{{os()}}" in
    macos)
        prefix=$(brew --prefix draco)
        ln -sfn "$prefix/include" third_party/draco/include
        ln -sfn "$prefix/lib" third_party/draco/lib ;;
    windows)
        prefix="$VCPKG_INSTALLATION_ROOT/installed/${DRACO_TRIPLET:-x64-windows-static}"
        cp -r "$prefix/include" third_party/draco/include
        cp -r "$prefix/lib" third_party/draco/lib ;;
    *)
        lib=$(find /usr/lib /usr/local/lib -name libdraco.a 2>/dev/null | head -1)
        if [ -z "$lib" ]; then echo "libdraco.a not found: install libdraco-dev" >&2; exit 1; fi
        ln -sfn /usr/include third_party/draco/include
        ln -sfn "$(dirname "$lib")" third_party/draco/lib ;;
    esac

# three.js into vendor/: three.core.js, three.module.js, three.webgpu.js and three.tsl.js
# (three/webgpu, three/tsl), and examples/jsm as jsm/ (three/addons/...)
[private]
three:
    #!/bin/sh
    set -e
    [ -f vendor/three.core.js ] && [ -f vendor/three.tsl.js ] && [ -d vendor/jsm ] && exit 0
    tgz=third_party/three-{{three_version}}.tgz
    {{just_executable()}} fetch https://registry.npmjs.org/three/-/three-{{three_version}}.tgz {{three_sha256}} $tgz
    mkdir -p third_party/three-{{three_version}} vendor
    tar -xzf $tgz -C third_party/three-{{three_version}} \
        package/LICENSE package/build/three.core.js package/build/three.module.js \
        package/build/three.webgpu.js package/build/three.tsl.js package/examples/jsm
    src=third_party/three-{{three_version}}/package
    cp $src/LICENSE $src/build/three.core.js $src/build/three.module.js $src/build/three.webgpu.js $src/build/three.tsl.js vendor/
    [ -d vendor/jsm ] || cp -R $src/examples/jsm vendor/jsm

