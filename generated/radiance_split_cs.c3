        int4 rc_pbase1;
        float4x4 rc_inv_vp;
        float4 rc_cam_pos;
        float4 rc_screen;
    };

    struct rc_voxel
    {
        uint albedo;
        uint emissive;
    };

    struct rc_gather_voxels
    {
        rc_voxel rc_vox_data[1];
    };

