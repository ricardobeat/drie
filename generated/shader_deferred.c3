fn SgShaderDesc deferred_mrt_shader_desc(SgBackend backend)
{
    SgShaderDesc desc;
    desc.label = "deferred_mrt_shader";
    switch (backend)
    {
        case SgBackend.GLCORE:
            desc.vertex_func.source = (ZString)&DEFERRED_VS_SOURCE_GLSL430;
            desc.vertex_func.entry = "main";
            desc.fragment_func.source = (ZString)&FS_DEFERRED_MRT_SOURCE_GLSL430;
            desc.fragment_func.entry = "main";
            desc.uniform_blocks[0].stage = SgShaderStage.FRAGMENT;
            desc.uniform_blocks[0].layout = SgUniformLayout.STD140;
            desc.uniform_blocks[0].size = 112;
            desc.uniform_blocks[0].glsl_uniforms[0].type = SgUniformType.FLOAT4;
            desc.uniform_blocks[0].glsl_uniforms[0].array_count = 7;
            desc.uniform_blocks[0].glsl_uniforms[0].glsl_name = "deferred_params";
            desc.uniform_blocks[1].stage = SgShaderStage.FRAGMENT;
            desc.uniform_blocks[1].layout = SgUniformLayout.STD140;
