{
    "langrev": "1",
    "dependency-search-paths": [
        "lib"
    ],
    "dependencies": [
        "sokol"
    ],
    "sources": [
        "./*",
        "generated/*",
        "platform/*"
    ],
    "c-sources": [
        "display.c",
        "platform/cgltf.c",
        "platform/readback.c",
        "platform/imageio.c",
        "platform/gamectl.c",
        "platform/readback_win.c",
        "platform/imageio_win.c",
        "platform/gamectl_win.c"
    ],
    "output": "build",
    "targets": {
        "drie-macos": {
            "type": "executable",
            "cflags": "-O2 -DNDEBUG -x objective-c -fobjc-arc"
        },
        "drie-linux": {
            "type": "executable"
        },
        "drie-windows": {
            "type": "executable"
        }
    }
}
