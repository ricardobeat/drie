        float4 frag;
        float4 vary0;
        float4 vary1;
        float4 vary2;
        float4 vary3;
        float4x4 instance_mat;
    };

    struct inst_index
    {
        uint index;
    };

    struct inst_counts
    {
        inst_index counts[1];
    };

    struct inst_visible
    {
        inst_index visible[1];
    };

    struct inst_row
    {
        float4 row;
    };

    struct inst_rows
