{
	"langrev": "1",
	"dependency-search-paths": [
		"lib",
		"../lib"
	],
	"dependencies": [
		"https://c3.ricar.do/github.com:ricardobeat/boomkat@jit",
		"sokol",
		"drie",
		"draco",
		"wamr"
	],
	"targets": {
		"driejs": {
			"type": "executable",
			"sources": [
				"src"
			],
			"opt": "O3",
			"macos-min-version": "15.0",
			"single-module": true,
			"fp-math": "relaxed",
			"debug-info": "none",
			"features": [
				"THREADED_DISPATCH",
				"PRINT",
				"CONSOLE",
				"SLJIT"
			]
		}
	}
}
