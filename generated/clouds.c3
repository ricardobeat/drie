fn SgShaderDesc cloud_shadow_shader_desc(SgBackend backend)
{
    SgShaderDesc desc;
    desc.label = "cloud_shadow_shader";
    switch (backend)
    {
        case SgBackend.GLCORE:
            $if !env::DARWIN && !env::WIN32 && !env::EMSCRIPTEN:
            desc.compute_func.source = CLOUD_SHADOW_CS_SOURCE_GLSL430;
            desc.compute_func.entry = "main";
            desc.uniform_blocks[0].stage = SgShaderStage.COMPUTE;
            desc.uniform_blocks[0].layout = SgUniformLayout.STD140;
            desc.uniform_blocks[0].size = 256;
