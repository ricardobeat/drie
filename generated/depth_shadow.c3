            desc.texture_sampler_pairs[1].stage = SgShaderStage.FRAGMENT;
            desc.texture_sampler_pairs[1].view_slot = 1;
            desc.texture_sampler_pairs[1].sampler_slot = 1;
            $else
                break;
            $endif
    }
    return desc;
}
