  if ((x_19 > 0.0f)) {
    let x_40 = v_uv;
    let x_41 = textureSample(s_map, s_smp, x_40);
    a = (x_41.w * x_13.s_params.y);
    if ((x_13.s_params.w > 0.5f)) {
