// Writes drie's C3 binding of cgltf, generated/cgltf.c3, from cgltf.h with bindgen.c3l:
// `just bindings`. Names lose cgltf's prefix: cgltf_parse_file is cgltf::parse_file,
// cgltf_texture_view CgltfTextureView, cgltf_result_success cgltf::RESULT_SUCCESS.
module cgltf_bind;
import bindgen, std::io;

fn String strip(String name) => name.starts_with("cgltf_") ? name[6..] : name;

fn String type_name(String name, Allocator alloc) {
    // (C's own types are bindgen's to name)
    if (!name.starts_with("cgltf_")) return name.copy(alloc);
    return bgstr::snake_to_pascal(name, alloc);
}

fn String func_name(String name, Allocator alloc) => strip(name).copy(alloc);

fn String const_name(String name, Allocator alloc) => bgstr::snake_to_screaming(strip(name), alloc);

fn void main(String[] args) {
    if (args.len < 3) {
        io::printn("usage: cgltf_bind <cgltf.h> <out.c3>");
        return;
    }
    BGTransCallbacks names = {
        .type = &type_name,
        .func = &func_name,
        .constant = &const_name,
    };
    bg::translate_header(args[1], { .out_name = args[2], .module_name = "drie::cgltf", .no_verbose = true }, names)!!;
    // (and what made it, on top)
    char[] text = file::load(mem, args[2])!!;
    defer free(text);
    File out = file::open(args[2], "wb")!!;
    defer (void)out.close();
    io::fprint(&out, "// Generated by `just bindings` (third_party/cgltf/bind.c3, with bindgen.c3l) from\n")!!;
    io::fprint(&out, "// third_party/cgltf/cgltf.h: do not edit. See cgltf.h for what each thing is.\n")!!;
    io::fprint(&out, (String)text)!!;
}
