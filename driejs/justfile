[private]
asset path sha256: (fetch examples + "/" + path sha256 "demos/" + path)

# downloads url to file unless it is there, and stops if its sha256 is not the one given
[private]
fetch url sha256 file:
    #!/bin/sh
    set -e
    [ -f "{{file}}" ] && exit 0
    mkdir -p "$(dirname "{{file}}")"
    curl -fsSL -o "{{file}}.part" "{{url}}"
    if [ "$(shasum -a 256 "{{file}}.part" | cut -d' ' -f1)" != "{{sha256}}" ]; then
        echo "{{file}}: its sha256 is not the one in the justfile ({{url}})" >&2
        exit 1
    fi
    mv "{{file}}.part" "{{file}}"
